# GTM Skills Showcase — Backend environment template.
# This is a standalone demo project — no OutMate credentials, secrets, or
# production endpoints belong here. Copy to `.env` and adjust if needed;
# the defaults below match docker-compose.yml as-is (local dev only).

DATABASE_URL=postgresql+psycopg://gtm:gtm_dev_password@localhost:5433/gtm_skills

ENVIRONMENT=development
LOG_LEVEL=INFO

# Comma-separated list of allowed frontend origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Production (Render) ──────────────────────────────────────────────────
# Set these as real environment variables in the Render dashboard — never
# commit real values here. See README.md's "Production Deployment" section
# for the full step-by-step.
#
# DATABASE_URL=<the "Internal Database URL" from your Render PostgreSQL
#   instance, pasted exactly as Render shows it — it will start with
#   postgresql:// or postgres:// (Render doesn't add a driver, that's
#   just the standard Postgres URL scheme) and will NOT have an sslmode
#   param. app/config.py normalizes both automatically at startup:
#   forces the psycopg3 driver (-> postgresql+psycopg://) and appends
#   ?sslmode=require for any non-localhost host (Render's Postgres
#   rejects unencrypted connections). Paste it exactly as Render shows
#   it — do not hand-edit the scheme or add sslmode yourself.
# ENVIRONMENT=production
# LOG_LEVEL=INFO
# CORS_ALLOWED_ORIGINS=https://YOUR-PROJECT.vercel.app
#   (comma-separated if you need more than one origin, e.g. a preview URL
#   too: https://YOUR-PROJECT.vercel.app,https://YOUR-PROJECT-git-main.vercel.app)
