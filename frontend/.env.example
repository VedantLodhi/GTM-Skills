# GTM Skills Showcase — Frontend environment template.
# Standalone demo project — no OutMate values belong here.

# Used by next.config.ts's rewrite AND by Server Components (lib/api/base.ts)
# to reach the FastAPI backend directly during SSR.
BACKEND_ORIGIN=http://127.0.0.1:8000

# ── Production (Vercel) ──────────────────────────────────────────────────
# Set as a real environment variable in the Vercel dashboard (Project
# Settings → Environment Variables) — never commit a real value here.
# Must be the live Render backend URL, with NO trailing slash, and never
# localhost/127.0.0.1. Changing this value requires a redeploy — Next.js
# reads it into next.config.ts's rewrite table at build time.
#
# BACKEND_ORIGIN=https://YOUR-BACKEND.onrender.com
